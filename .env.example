# SkillLink GH Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# Firebase Configuration (Android)
FIREBASE_ANDROID_API_KEY=your_firebase_android_key_here

# Firebase Configuration (Web)
FIREBASE_WEB_API_KEY=your_firebase_web_key_here
FIREBASE_AUTH_DOMAIN=skill-link-gh.firebaseapp.com
FIREBASE_PROJECT_ID=skill-link-gh
FIREBASE_STORAGE_BUCKET=skill-link-gh.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_APP_ID=your_app_id_here

# Paystack Keys
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Backend API URL
API_BASE_URL=https://100-60-0-32.sslip.io
